# Flask Configuration
SECRET_KEY=grimbots-super-segura-chave-aleatoria-2024-production-min-32-chars
FLASK_ENV=production

# Database (PostgreSQL dentro do container)
DATABASE_URL=postgresql://botmanager:grimbots-db-senha-forte-2024@localhost:5432/botmanager_db

# SyncPay API (CREDENCIAIS REAIS)
SYNCPAY_CLIENT_ID=48d5a474-1853-4122-bd4e-51f71adaf12f
SYNCPAY_CLIENT_SECRET=fd3088d8-5feb-4a70-993e-903a5e719854

# Platform Split Payment (SEU ID PARA RECEBER COMISSOES)
PLATFORM_SPLIT_USER_ID=48d5a474-1853-4122-bd4e-51f71adaf12f

# Webhook URL (SEU DOMINIO)
WEBHOOK_URL=https://grimbots.online

# Server Port
PORT=5000

# Grimbots AI Gateway (bloco 'ai' do Flow Editor) — opcional/opt-in
# API URL do Gateway (producao = ngrok URL fixa; dev local = http://127.0.0.1:8000)
GRIMBOTS_AI_API_URL=https://majority-joyfully-mama.ngrok-free.dev
# API Key (header X-API-Key) - NAO commite a chave real
GRIMBOTS_AI_API_KEY=gp_
# Timeout cliente (segundos) - deve ser >= 90 (servidor timeout em 60)
GRIMBOTS_AI_TIMEOUT=90
# true = usa MockAIService (nenhuma chamada real ao Gateway)
GRIMBOTS_AI_MOCK=false
# Fase 6A — contrato: v1.0 (default, comportamento atual) | v1.1 (habilita campos novos).
# !!! NAO ativar v1.1 antes do AI Gateway aceitar agent_profile/flow_resources/context_policy.
# Mesmo com v1.1 aqui, o envio ainda exige step_config['contract_v11']=true no bloco.
GRIMBOTS_AI_CONTRACT=v1.0
# Piloto controlado — desliga a IA GLOBALMENTE (todo bloco 'ai' vai para HUMANO).
GRIMBOTS_AI_KILL_SWITCH=false
# Piloto controlado — percentual de leads elegíveis (0-100). Default 100 = sem restrição.
GRIMBOTS_AI_ROLLOUT_PERCENT=100
# Piloto ISOLADO — allowlist EXPLÍCITA de bots autorizados (IDs separados por vírgula).
# Vazio = sem trava por bot. Não-vazio = SOMENTE esses bots usam a IA; os demais vão
# para HUMANO. Ex.: GRIMBOTS_AI_BOT_ALLOWLIST=140 restringe a IA ao bot 140.
GRIMBOTS_AI_BOT_ALLOWLIST=
